# Copy this file to .env and fill in the values. Never commit the real .env.

# Neon / PostgreSQL. DATABASE_URL is the pooled connection, DIRECT_URL the direct one (used by migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Signs the login cookie. At least 32 random characters.
AUTH_SECRET=""

# Comma separated emails that become ADMIN when they register.
ADMIN_EMAILS="you@example.com"

# Codeforces API key and secret of the account that manages the private group (Settings > API).
CF_API_KEY=""
CF_API_SECRET=""

# Protects /api/cron/sync-sheets. Vercel Cron sends it as "Authorization: Bearer <value>".
CRON_SECRET=""
